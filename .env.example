# Otakomi Frontend Environment Variables

# API Configuration
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Application Configuration
VITE_APP_NAME=Otakomi
VITE_APP_VERSION=1.0.0

# WebRTC Configuration
VITE_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Feature Flags
VITE_ENABLE_EMOTION_ANALYSIS=true
VITE_ENABLE_CALL_RECORDING=true
VITE_ENABLE_FACE_DETECTION=true