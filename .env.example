# Local development environment variables
VITE_API_BASE_URL=https://otakomi-backend.onrender.com/api/v1
VITE_SOCKET_URL=https://otakomi-backend.onrender.com
VITE_API_BASE_URL_DEV=http://localhost:8080/api/v1
VITE_SOCKET_URL_DEV=http://localhost:8080
VITE_APP_NAME=Otakomi
VITE_APP_VERSION=1.0.0
VITE_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
VITE_ENABLE_EMOTION_ANALYSIS=true
VITE_ENABLE_CALL_RECORDING=true
VITE_ENABLE_FACE_DETECTION=true
# Google OAuth Client ID - Get from Google Cloud Console
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
# Groq AI API Key - Get your free key from: https://console.groq.com/keys
VITE_GROQ_API_KEY="gsk_your_api_key_here"